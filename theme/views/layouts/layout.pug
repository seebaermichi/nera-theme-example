//- The base shell every page type extends. It owns <head>, header, footer and
//- scripts; page templates under views/pages/ fill the `content` block. A site
//- overriding this one file reshells every page type at once.
doctype html
html(lang=meta.lang || app.lang || 'en')
    head
        include ../partials/head.pug
    body
        include ../partials/header.pug
        main.content
            block content
                != content
        include ../partials/footer.pug
        include ../partials/scripts.pug
